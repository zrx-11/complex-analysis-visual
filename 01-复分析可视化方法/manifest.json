  "glossary": [
    {
      "term": "复平面",
      "def": "用平面上的点表示复数的坐标系，横轴实轴、纵轴虚轴",
      "chapterId": "ch01"
    },
    {
      "term": "模",
      "def": "复数对应箭头的长度，记 |z|",
      "chapterId": "ch01"
    },
    {
      "term": "辐角",
      "def": "箭头与正实轴的夹角，记 arg z，可差 2π 的整数倍",
      "chapterId": "ch01"
    },
    {
      "term": "复共轭",
      "def": "关于实轴的镜像，记 z 上加横线；z z̄ = |z|²",
      "chapterId": "ch01"
    },
    {
      "term": "极坐标记法",
      "def": "z = r∠θ，r 是长度、θ 是角度",
      "chapterId": "ch01"
    },
    {
      "term": "欧拉公式",
      "def": "e^(iθ) = cosθ + i sinθ，即单位圆上的角度标记",
      "chapterId": "ch01"
    },
    {
      "term": "单位根",
      "def": "zⁿ = 1 的 n 个解，均匀分布在单位圆上",
      "chapterId": "ch01"
    },
    {
      "term": "有符号面积",
      "def": "叉乘在平面上的定义，逆时针为正、顺时针为负",
      "chapterId": "ch01"
    },
    {
      "term": "运动",
      "def": "平面到自身、保持任意两点距离不变的映射",
      "chapterId": "ch01"
    },
    {
      "term": "保向 / 反向",
      "def": "保持角度定向的变换（平移、旋转）/ 翻转定向的变换（反射）",
      "chapterId": "ch01"
    },
    {
      "term": "群",
      "def": "含恒等、有逆、对复合封闭的变换族",
      "chapterId": "ch01"
    },
    {
      "term": "象平面",
      "def": "复函数把 z 平面上的点搬到 w 平面，w 平面即象平面",
      "chapterId": "ch02"
    },
    {
      "term": "收敛圆",
      "def": "幂级数在 |z|<ρ 内收敛、|z|>ρ 外发散的圆盘边界",
      "chapterId": "ch02"
    },
    {
      "term": "绝对收敛",
      "def": "各项的模构成的级数收敛，是比收敛更强的要求",
      "chapterId": "ch02"
    },
    {
      "term": "支点",
      "def": "z 绕它一圈回到原处时，多值函数回不到原值的点",
      "chapterId": "ch02"
    },
    {
      "term": "单值支",
      "def": "沿支点剪开平面后，多值函数分出的每个单值分支",
      "chapterId": "ch02"
    },
    {
      "term": "对数支点",
      "def": "绕任意多圈都回不到原值的支点，如 log z 的 0",
      "chapterId": "ch02"
    }
  ],
