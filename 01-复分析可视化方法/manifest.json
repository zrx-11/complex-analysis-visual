  "quizzes": [
    {
      "id": "q01",
      "chapterId": "ch01",
      "type": "single",
      "question": "$(1+i)^4$ 等于多少？",
      "options": [
        "4",
        "-4",
        "4i",
        "-4i"
      ],
      "answer": 1,
      "explain": "$1+i=\\sqrt2\\angle45°$，四次方后长度为 $(\\sqrt2)^4=4$、角度为 $180°$，落在负实轴，得 $-4$。",
      "relatedConceptId": "c01"
    },
    {
      "id": "q02",
      "chapterId": "ch01",
      "type": "single",
      "question": "乘以 $i$ 对平面上每个非零向量的作用是什么？",
      "options": [
        "放大一倍",
        "逆时针转 90°",
        "关于实轴反射",
        "取倒数"
      ],
      "answer": 1,
      "explain": "$i$ 的长度为 1、辐角为 90°，乘法只改角度，所以是纯旋转。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q03",
      "chapterId": "ch01",
      "type": "single",
      "question": "$z^5=1$ 的五个根在复平面上构成什么图形？",
      "options": [
        "一条直线",
        "内接正五边形",
        "圆内随机五点",
        "两条相交直线"
      ],
      "answer": 1,
      "explain": "根是 $e^{ik2\\pi/5}$，等角分布在单位圆上，正好是正五边形顶点。",
      "relatedConceptId": "c04"
    },
    {
      "id": "q04",
      "chapterId": "ch01",
      "type": "multi",
      "question": "下面哪些命题等价于 $B=iA$？",
      "options": [
        "$B$ 由 $A$ 逆时针转 90° 得到",
        "$B$ 与 $A$ 垂直且等长",
        "$A+iB=0$",
        "$B$ 是 $A$ 的复共轭"
      ],
      "answer": [
        0,
        1,
        2
      ],
      "explain": "$iA$ 即转 90°；转 90° 同时保持长度，所以垂直且等长；$B=iA$ 等价于 $A+iB=0$。共轭是镜像，方向不对。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q05",
      "chapterId": "ch01",
      "type": "single",
      "question": "$\\cos^4\\theta$ 用倍角表示是哪一个？",
      "options": [
        "$\\frac12(\\cos2\\theta+1)$",
        "$\\frac18(\\cos4\\theta+4\\cos2\\theta+3)$",
        "$\\frac14(\\cos4\\theta+3)$",
        "$\\frac12(\\cos4\\theta+\\cos2\\theta)$"
      ],
      "answer": 1,
      "explain": "由 $2\\cos\\theta=e^{i\\theta}+e^{-i\\theta}$，四次方展开、配对成 $2\\cos k\\theta$，再除以 $2^4$。",
      "relatedConceptId": "c03"
    },
    {
      "id": "q06",
      "chapterId": "ch01",
      "type": "single",
      "question": "$\\left|e^{i\\theta}\\right|$ 等于多少？",
      "options": [
        "$\\theta$",
        "1",
        "$\\cos\\theta$",
        "随 θ 变化"
      ],
      "answer": 1,
      "explain": "$e^{i\\theta}$ 是单位圆上的点，到原点的距离恒为 1。",
      "relatedConceptId": "c03"
    },
    {
      "id": "q07",
      "chapterId": "ch01",
      "type": "single",
      "question": "$\\bar ab$ 的实部对应哪一种向量运算？",
      "options": [
        "叉乘",
        "点乘",
        "加法",
        "模长之比"
      ],
      "answer": 1,
      "explain": "$\\bar ab=|a||b|e^{i(\\beta-\\alpha)}$，实部是 $|a||b|\\cos\\theta$，正是点乘。",
      "relatedConceptId": "c05"
    },
    {
      "id": "q08",
      "chapterId": "ch01",
      "type": "single",
      "question": "证明“四边形四边作正方形、对边中心连线垂直等长”时，封口条件 $a+b+c+d=0$ 起了什么作用？",
      "options": [
        "保证四边形是凸的",
        "让 $A+iB$ 的实部与虚部同时归零",
        "保证正方形不自交",
        "让两条连线平行"
      ],
      "answer": 1,
      "explain": "算出 $A+iB=(a+b+c+d)+i(a+b+c+d)$，封口条件使两项同时为零，于是 $A+iB=0$，即 $B=iA$。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q09",
      "chapterId": "ch01",
      "type": "single",
      "question": "每个保向运动都可以写成什么形式？",
      "options": [
        "$M(z)=\\bar z+v$",
        "$M(z)=e^{i\\theta}z+v$",
        "$M(z)=z^2+v$",
        "$M(z)=e^{i\\theta}\\bar z+v$"
      ],
      "answer": 1,
      "explain": "保向运动 = 旋转加平移，即 $e^{i\\theta}z+v$；含 $\\bar z$ 的变换会翻转定向。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q10",
      "chapterId": "ch01",
      "type": "single",
      "question": "两条相交直线 $L_1,L_2$ 交于 $O$、夹角 $\\varphi$，连续做两次反射 $\\mathcal R_{L_2}\\circ\\mathcal R_{L_1}$ 的结果是什么？",
      "options": [
        "平移 $2V$",
        "绕 $O$ 转 $2\\varphi$",
        "关于 O 的中心对称",
        "恒等变换"
      ],
      "answer": 1,
      "explain": "两次反射把角的定向翻转两次，净效果保向；不动曲线是以 O 为心的圆，所以是绕 O 旋转，角度为 $2\\varphi$。",
      "relatedConceptId": "c02"
    },
    {
      "id": "q11",
      "chapterId": "ch02",
      "type": "single",
      "question": "$w=z^3$ 把张角 $30°$ 的角形区域映成多大的角？",
      "options": [
        "10°",
        "30°",
        "90°",
        "120°"
      ],
      "answer": 2,
      "explain": "$z^3$ 把角度乘以 3，$30°\\times3=90°$。",
      "relatedConceptId": "c06"
    },
    {
      "id": "q12",
      "chapterId": "ch02",
      "type": "single",
      "question": "$z^4=16$ 的解在复平面上构成什么图形？",
      "options": [
        "半径 2 的正方形四个顶点",
        "半径 4 的正方形",
        "半径 2 的圆上任意四点",
        "一条直线"
      ],
      "answer": 0,
      "explain": "$r^4=16$ 得 $r=2$，四个解相差 $90°$，是内接正方形。",
      "relatedConceptId": "c06"
    },
    {
      "id": "q13",
      "chapterId": "ch02",
      "type": "single",
      "question": "幂级数在 $z=a$ 处收敛，可以推出什么？",
      "options": [
        "在全平面收敛",
        "在 $|z|<|a|$ 内绝对收敛",
        "在 $|z|=|a|$ 上收敛",
        "在 $|z|>|a|$ 发散"
      ],
      "answer": 1,
      "explain": "教材式 2.8：在 $a$ 收敛则圆盘 $|z|<|a|$ 内处处绝对收敛，收敛域只能向内封闭。",
      "relatedConceptId": "c07"
    },
    {
      "id": "q14",
      "chapterId": "ch02",
      "type": "multi",
      "question": "下面哪些是 $e^z$ 的几何事实？",
      "options": [
        "周期为 $2\\pi i$",
        "把高度 $2\\pi$ 的水平带铺满全平面（去掉 0）",
        "把虚轴映成单位圆",
        "是一对一映射"
      ],
      "answer": [
        0,
        1,
        2
      ],
      "explain": "$e^z$ 周期 $2\\pi i$，所以非一对一；虚轴 $e^{iy}$ 在单位圆上；水平带铺满 $w$ 平面去掉 0。",
      "relatedConceptId": "c08"
    },
    {
      "id": "q15",
      "chapterId": "ch02",
      "type": "single",
      "question": "$\\sqrt[3]{z}$ 的支点在哪，阶数是多少？",
      "options": [
        "$z=1$，一阶",
        "$z=0$，二阶",
        "$z=0$，一阶",
        "没有支点"
      ],
      "answer": 1,
      "explain": "绕 0 三圈才回到原值，$n=3$，阶数 $n-1=2$。",
      "relatedConceptId": "c09"
    },
    {
      "id": "q16",
      "chapterId": "ch02",
      "type": "single",
      "question": "$z^3=c$ 的三个解，相邻两个相差多少角度？",
      "options": [
        "60°",
        "90°",
        "120°",
        "180°"
      ],
      "answer": 2,
      "explain": "解为 $\\sqrt[3]{R}e^{i(\\varphi+2m\\pi)/3}$，相邻差 $2\\pi/3=120°$。",
      "relatedConceptId": "c06"
    },
    {
      "id": "q17",
      "chapterId": "ch02",
      "type": "single",
      "question": "为什么 $e^z$ 的收敛半径是无穷，而 $\\frac{1}{1-z}$ 的幂级数只有半径 1？",
      "options": [
        "$e^z$ 的系数 $1/n!$ 衰减极快",
        "$\\frac{1}{1-z}$ 的系数全是 1，$|z|\\ge1$ 时通项不趋于零",
        "$e^z$ 不是幂级数",
        "两者半径其实一样"
      ],
      "answer": 0,
      "explain": "$e^z$ 的系数 $1/n!$ 使比值 $\\to\\infty$，半径无穷；$\\frac{1}{1-z}$ 的系数全为 1，且在 $z=1$ 处奇点挡路，半径只能到 1。",
      "relatedConceptId": "c07"
    },
    {
      "id": "q18",
      "chapterId": "ch02",
      "type": "single",
      "question": "$z$ 绕原点一圈回到原处，$\\sqrt[3]{z}$ 的值会怎样？",
      "options": [
        "回到原值",
        "变成另一个立方根",
        "变为原来的一半",
        "趋于无穷"
      ],
      "answer": 1,
      "explain": "角度累计 $2\\pi$，$\\sqrt[3]{z}$ 的角度增加 $2\\pi/3$，落到另一个分支。",
      "relatedConceptId": "c09"
    },
    {
      "id": "q19",
      "chapterId": "ch02",
      "type": "single",
      "question": "$e^z$ 的周期是多少？",
      "options": [
        "$2\\pi$",
        "$\\pi i$",
        "$2\\pi i$",
        "没有周期"
      ],
      "answer": 2,
      "explain": "$e^{z+2\\pi i}=e^z e^{2\\pi i}=e^z$，$e^{2\\pi i}=1$。",
      "relatedConceptId": "c08"
    }
  ],
